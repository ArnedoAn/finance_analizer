# Finance Analyzer v3. Copy to .env; never commit credentials.
# FINANCE_API_KEY: random, at least 32 characters; never use these placeholders.
FINANCE_API_KEY=replace-with-random-admin-secret-at-least-32-characters
# Optional and transitional: legacy phone key, migrated on first use to the ingest device `phone-legacy`.
# Leave unset on new installs (devices enroll with a QR code); an empty value is rejected. Remove once that device is revoked.
# PHONE_API_KEY=replace-with-random-phone-secret-at-least-32-characters
APP_ENV=development
EXPOSE_DOCS=false
DATABASE_URL=sqlite+aiosqlite:///./data/finance_v3.db
TIMEZONE=America/Bogota
LOG_LEVEL=INFO

FIREFLY_BASE_URL=http://localhost:8080
FIREFLY_API_TOKEN=
MANUAL_DEFAULT_ACCOUNT=Efectivo
FIREFLY_CACHE_TTL_MINUTES=360
# Exact existing Firefly account names; no automatic account fallback for bank events.
# Add every actual app package/SMS short code/domain used by your accounts.
OWN_ACCOUNTS='[{"firefly_account":"Nequi","bank":"nequi","kind":"wallet","last4":[],"aliases":["nequi"],"sources":["app:com.nequi.MobileApp","email:nequi.com.co"]},{"firefly_account":"Bancolombia","bank":"bancolombia","kind":"savings","last4":["1234"],"aliases":["bancolombia"],"sources":["app:com.bancolombia.personas.superapp","sms:87400","sms:890099","email:bancolombia.com.co"]},{"firefly_account":"Efectivo","bank":"cash","kind":"cash","last4":[],"aliases":["efectivo"],"sources":[]}]'

# JSON; gmail/yahoo/icloud provide host. Custom requires host and trusted authserv_ids.
MAIL_ACCOUNTS='[]'
# MAIL_ACCOUNTS='[{"name":"personal","provider":"gmail","username":"owner@gmail.com","password":"app-password","folder":"INBOX","port":993,"ssl":true}]'
EMAIL_LOOKBACK_DAYS=7
EMAIL_MAX_BODY_CHARS=12000

LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODELS=deepseek-v4.1-flash,hy3,mimo-v2.6-flash
LLM_USER_AGENT=finance-analyzer/3.0
LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=deepseek-chat

DEDUP_WINDOW_MINUTES=60
TRANSFER_PAIR_WINDOW_MINUTES=30
MAX_AMOUNT_COP=50000000
REVIEW_AMOUNT_COP=2000000
# LLM output requires human review by default; raising this explicitly allows auto-approval.
LLM_AUTO_APPROVE_MAX_COP=0
# SMS sender IDs can be spoofed; use 0 to require review for every SMS.
SMS_AUTO_APPROVE_MAX_COP=0
FAIL_AFTER_HOURS=72
RAW_TEXT_RETENTION_DAYS=30
SCHEDULER_ENABLED=true
CYCLE_CRON=0 * * * *
SENDER_LEARNING_CRON=0 3 1,15 * *
RECONCILE_CRON=0 4 * * *

# Alerts are rows in the `alerts` table polled by the app (GET /alerts); no bot or push endpoint.
# Anti-noise: minimum minutes between repeats of the same alert type/key.
NOTIFY_MIN_INTERVAL_MINUTES=15
PHONE_SILENCE_HOURS=24
DIGEST_CRON=0 8 * * *
WEEKLY_DIGEST_CRON=0 8 * * 1

# Mounted secrets: omit the direct value when using its *_FILE equivalent.
# Supported: FINANCE_API_KEY, PHONE_API_KEY, DATABASE_URL, FIREFLY_API_TOKEN,
# LLM_API_KEY, LLM_FALLBACK_API_KEY, MAIL_ACCOUNTS, OWN_ACCOUNTS, FIELD_ENCRYPTION_KEY.
# FINANCE_API_KEY_FILE=/run/secrets/finance_api_key
# PHONE_API_KEY_FILE=/run/secrets/phone_api_key
# DATABASE_URL_FILE=/run/secrets/database_url
# MAIL_ACCOUNTS_FILE=/run/secrets/mail_accounts.json
# OWN_ACCOUNTS_FILE=/run/secrets/own_accounts.json
# Base64 32-byte master key for field encryption (mounted file; never commit the value).
# FIELD_ENCRYPTION_KEY_FILE=/run/secrets/field_encryption_key
# JSON status written by the backup job and read by GET /backup/status.
# BACKUP_STATUS_FILE=/var/lib/finance/backup-status.json
