# Finance Analyzer v2: copy to .env; never commit credentials.
FINANCE_API_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite+aiosqlite:///./data/finance_v2.db
TIMEZONE=America/Bogota

FIREFLY_BASE_URL=https://firefly.example.com
FIREFLY_API_TOKEN=
FIREFLY_DEFAULT_ASSET_ACCOUNT=Efectivo
MANUAL_DEFAULT_ACCOUNT=Efectivo
FIREFLY_CACHE_TTL_MINUTES=360
AUTO_CREATE_CATEGORIES=false
# Existing Firefly asset names only. Keys: app package, sms:sender, email substring.
ACCOUNT_MAP='{"com.todo1.mobile":"Bancolombia","sms:Bancolombia":"Bancolombia","bancolombia.com":"Bancolombia"}'

# JSON list; Gmail requires an app password, not OAuth. Outlook: forward to IMAP.
# Providers gmail/yahoo/icloud supply host; custom requires host.
MAIL_ACCOUNTS='[]'
# MAIL_ACCOUNTS='[{"name":"personal","provider":"gmail","username":"owner@gmail.com","password":"app-password","folder":"INBOX","ssl":true,"port":993}]'
EMAIL_LOOKBACK_DAYS=7
EMAIL_MAX_BODY_CHARS=12000

LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODELS=deepseek-v4.1-flash,hy3,mimo-v2.6-flash
LLM_USER_AGENT=finance-analyzer/2.0
LLM_FALLBACK_BASE_URL=https://api.deepseek.com/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=deepseek-chat

DEDUP_WINDOW_MINUTES=60
MAX_ATTEMPTS=8
SCHEDULER_ENABLED=true
CYCLE_CRON=0 * * * *
SENDER_LEARNING_CRON=0 3 1,15 * *

# Docker deployment settings (not application settings).
FINANCE_IMAGE=ghcr.io/your-owner/finance-analyzer:latest
PORT=8000
POSTGRES_USER=finance_analyzer
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
POSTGRES_DB=finance_analyzer_v2
